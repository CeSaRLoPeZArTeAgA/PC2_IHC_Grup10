digraph Flow {
 graph [rankdir=TB, bgcolor=white, pad=.2, nodesep=.22, ranksep=.3];
 node [shape=box, style="rounded,filled", fillcolor="#ECF7F7", color="#487A82", fontname="DejaVu Sans", fontsize=10];
 edge [color="#477881", fontname="DejaVu Sans", fontsize=9];
 a [label="1. Preferencias y aviso"];
 b [label="2. Silueta, voz o texto"];
 c [label="Confirmar región",shape=diamond,fillcolor="#FFF1D7"];
 d [label="3. Entrevista guiada"];
 e [label="4. Revisar declaraciones"];
 f [label="5. Resumen · IA identificada"];
 g [label="Enviar / pendiente de conexión"];
 h [label="Rol médico: código / recepción"];
 i [label="Respuesta y consulta de estado"];
 a -> b -> c; c -> b [label="Corregir"];c -> d [label="Sí"];d -> e; e -> d [label="Editar"];e -> f -> g -> h -> i;
}
